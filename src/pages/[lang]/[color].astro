---
import ScreenPage from "../../components/ScreenPage.astro";
import { colors } from "../../data/colors";
import { locales } from "../../i18n/translations";

export function getStaticPaths() {
  return locales.filter((locale) => locale !== "en").flatMap((locale) => colors.slice(1).map((color) => ({ params: { lang: locale, color: color.slug }, props: { locale, color } })));
}

const { locale, color } = Astro.props;
---
<ScreenPage color={color} locale={locale} />
