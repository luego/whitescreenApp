---
import WhiteScreen from "../../components/WhiteScreen.astro";
import Layout from "../../layouts/Layout.astro";
import { colors } from "../../data/colors";
import { locales, pageMeta } from "../../i18n/translations";

export function getStaticPaths() {
  return locales.filter((locale) => locale !== "en").map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props;
const color = colors[0];
const meta = pageMeta(locale, color);
---

<Layout title={meta.title} description={meta.description} locale={locale} color={color}>
  <WhiteScreen color={color} locale={locale} />
</Layout>
