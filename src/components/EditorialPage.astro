---
import Layout from "../layouts/Layout.astro";
import { locales, localizedPath, type Locale } from "../i18n/translations";
import { legalCopy } from "../i18n/legal";
import { editorialCopy, editorialPath, type GuideSlug } from "../i18n/editorial";
import SiteHeader from "./SiteHeader.astro";
import SiteFooter from "./SiteFooter.astro";
import GuideHub from "./GuideHub.astro";
interface Props { locale:Locale; page:"about"|GuideSlug }
const { locale, page } = Astro.props;
const e = editorialCopy[locale]; const legal = legalCopy[locale];
const article = page === "about" ? e.about : e.guides[page];
const alternatePaths = Object.fromEntries(locales.map((item) => [item, editorialPath(item, page)])) as Record<Locale,string>;
---
<Layout title={`${article.title} | White Screen`} description={article.description} locale={locale} alternatePaths={alternatePaths} pageType="page">
<main class="site-shell info-page">
  <SiteHeader locale={locale} languagePaths={alternatePaths} secondaryLink={{href:editorialPath(locale,"about"),label:e.labels.about}} />
  <article class="legal-page editorial-page"><a class="back-link" href={localizedPath(locale)}>← {legal.nav.back}</a><header class="legal-hero"><p class="eyebrow">{article.eyebrow}</p><h1>{article.title}</h1><p>{article.intro}</p></header><div class="legal-sections">{article.sections.map(section=><section><h2>{section.title}</h2><p>{section.body}</p></section>)}</div></article>
  <GuideHub locale={locale} current={page === "about" ? undefined : page} />
  <SiteFooter locale={locale} languagePaths={alternatePaths} />
</main>
</Layout>
