---
import Layout from "../layouts/Layout.astro";
import { copy, localeNames, locales, localizedPath, type Locale } from "../i18n/translations";
import { legalCopy, legalPath, type LegalPageKey } from "../i18n/legal";
import { editorialCopy, editorialPath } from "../i18n/editorial";

interface Props { locale: Locale; page: LegalPageKey }
const { locale, page } = Astro.props;
const t = copy[locale];
const legal = legalCopy[locale];
const editorial = editorialCopy[locale];
const content = legal[page];
const alternatePaths = Object.fromEntries(locales.map((item) => [item, legalPath(item, page)]));
const feedbackEmail = import.meta.env.PUBLIC_FEEDBACK_EMAIL?.trim();
---

<Layout title={`${content.title} | White Screen`} description={content.description} locale={locale} alternatePaths={alternatePaths} pageType="page">
  <main class="site-shell info-page">
    <header class="topbar">
      <a href={localizedPath(locale)} class="brand" aria-label="White Screen"><span class="brand-mark" aria-hidden="true"></span><span>White Screen</span></a>
      <div class="header-actions">
        <details class="language-menu">
          <summary aria-label={t.language} title={t.language}><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"></path></svg><span>{locale.toUpperCase()}</span></summary>
          <div>{locales.map((item) => <a href={legalPath(item, page)} lang={item} aria-current={item === locale ? "page" : undefined}>{localeNames[item]}</a>)}</div>
        </details>
        <div class="theme-switcher" role="group" aria-label="Theme">
          <button data-theme-choice="light" class="theme-button" type="button" aria-label={t.light} title={t.light}><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41"></path></svg></button>
          <button data-theme-choice="dark" class="theme-button" type="button" aria-label={t.dark} title={t.dark}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"></path></svg></button>
          <button data-theme-choice="system" class="theme-button" type="button" aria-label={t.system} title={t.system}><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="13" rx="2"></rect><path d="M8 21h8M12 17v4"></path></svg></button>
        </div>
      </div>
    </header>

    <article class="legal-page">
      <a class="back-link" href={localizedPath(locale)}>← {legal.nav.back}</a>
      <header class="legal-hero"><p class="eyebrow">White Screen</p><h1>{content.title}</h1><p>{content.description}</p>{page !== "feedback" && <small>{content.updated}</small>}</header>

      {page !== "feedback" ? (
        <div class="legal-sections">{content.sections.map((section) => <section><h2>{section.title}</h2><p>{section.body}</p></section>)}</div>
      ) : (
        <section class="feedback-panel">
          <p class="feedback-intro">{content.intro}</p>
          <form class="feedback-form" data-feedback-form data-feedback-email={feedbackEmail}>
            <div class="form-grid">
              <label><span>{content.name}</span><input name="name" type="text" autocomplete="name" /></label>
              <label><span>{content.email}</span><input name="email" type="email" autocomplete="email" /></label>
            </div>
            <label><span>{content.category}</span><select name="category">{content.categories.map((category) => <option value={category}>{category}</option>)}</select></label>
            <label><span>{content.message}</span><textarea name="message" rows="7" required></textarea></label>
            <button class="feedback-submit" type="submit" disabled={!feedbackEmail}>{content.send}<span aria-hidden="true">↗</span></button>
            <p class:list={["form-note", { warning: !feedbackEmail }]}>{feedbackEmail ? content.note : content.unavailable}</p>
          </form>
        </section>
      )}
    </article>

    <footer>
      <div class="footer-copy"><a href={localizedPath(locale)}>White Screen</a><span>{t.footer}</span></div>
      <div class="footer-navs">
        <nav class="footer-legal" aria-label="Legal"><a href={editorialPath(locale,"about")}>{editorial.labels.about}</a><a href={legalPath(locale, "privacy")}>{legal.nav.privacy}</a><a href={legalPath(locale, "terms")}>{legal.nav.terms}</a><a href={legalPath(locale, "feedback")}>{legal.nav.feedback}</a></nav>
        <nav class="footer-languages" aria-label={t.language}>{locales.map((item) => <a href={legalPath(item, page)} lang={item} aria-current={item === locale ? "page" : undefined}>{localeNames[item]}</a>)}</nav>
      </div>
    </footer>
  </main>
</Layout>

<script>
  const media = window.matchMedia("(prefers-color-scheme: dark)");
  const applyTheme = (mode: string) => {
    const dark = mode === "dark" || (mode === "system" && media.matches);
    document.documentElement.dataset.theme = dark ? "night" : "bumblebee";
    document.querySelector('meta[name="theme-color"]')?.setAttribute("content", dark ? "#0f172a" : "#facc15");
    document.querySelectorAll<HTMLElement>("[data-theme-choice]").forEach((button) => button.classList.toggle("active", button.dataset.themeChoice === mode));
  };
  let themeMode = localStorage.getItem("theme-mode") || "system";
  applyTheme(themeMode);
  document.querySelectorAll<HTMLElement>("[data-theme-choice]").forEach((button) => button.addEventListener("click", () => { themeMode = button.dataset.themeChoice || "system"; localStorage.setItem("theme-mode", themeMode); applyTheme(themeMode); }));
  media.addEventListener("change", () => { if (themeMode === "system") applyTheme(themeMode); });

  document.querySelector<HTMLFormElement>("[data-feedback-form]")?.addEventListener("submit", (event) => {
    event.preventDefault();
    const form = event.currentTarget as HTMLFormElement;
    const recipient = form.dataset.feedbackEmail;
    if (!recipient) return;
    const data = new FormData(form);
    const category = String(data.get("category") || "Feedback");
    const body = [`Name: ${data.get("name") || "-"}`, `Reply email: ${data.get("email") || "-"}`, "", String(data.get("message") || "")].join("\n");
    window.location.href = `mailto:${recipient}?subject=${encodeURIComponent(`[White Screen] ${category}`)}&body=${encodeURIComponent(body)}`;
  });
</script>
