---
import { copy, type Locale } from "../i18n/translations";
interface Props { locale: Locale }
const { locale } = Astro.props; const t = copy[locale];
---
<div class="theme-switcher" role="group" aria-label="Theme">
  <button @click="$store.theme.set('light')" :class="$store.theme.mode === 'light' && 'active'" :aria-pressed="$store.theme.mode === 'light'" class="theme-button" type="button" aria-label={t.light} title={t.light}><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41"></path></svg></button>
  <button @click="$store.theme.set('dark')" :class="$store.theme.mode === 'dark' && 'active'" :aria-pressed="$store.theme.mode === 'dark'" class="theme-button" type="button" aria-label={t.dark} title={t.dark}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"></path></svg></button>
  <button @click="$store.theme.set('system')" :class="$store.theme.mode === 'system' && 'active'" :aria-pressed="$store.theme.mode === 'system'" class="theme-button" type="button" aria-label={t.system} title={t.system}><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="13" rx="2"></rect><path d="M8 21h8M12 17v4"></path></svg></button>
</div>
