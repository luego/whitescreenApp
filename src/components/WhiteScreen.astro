---
import { colors, colorPath, type ScreenColor } from "../data/colors";
interface Props { color: ScreenColor }
const { color } = Astro.props;
const isWhite = color.slug === "";
---

<main x-data={`screenTool('${color.hex}')`} class="site-shell">
  <header class="topbar">
    <a href="/" class="brand" aria-label="White Screen — inicio"><span class="brand-mark" aria-hidden="true"></span><span>White Screen</span></a>
    <span class="top-note">Herramienta gratuita · Sin registro</span>
  </header>

  <section class="hero" aria-labelledby="page-title">
    <div class="hero-copy">
      <p class="eyebrow">Pantalla de color online</p>
      <h1 id="page-title">Pantalla {color.adjective}</h1>
      <p>Una superficie limpia para iluminar, revisar tu monitor o trabajar sin distracciones.</p>
    </div>
    <button x-ref="canvas" @click="openFullscreen()" @keydown.f.window.prevent="openFullscreen()" class="screen-preview" style={`--screen-color:${color.hex}; --screen-text:${color.text}`} type="button" aria-label={`Abrir pantalla ${color.adjective} en pantalla completa`}>
      <span class="preview-label">Haz clic o pulsa F</span>
      <span class="preview-action">Pantalla completa <span aria-hidden="true">↗</span></span>
    </button>
  </section>

  <section class="tool-card" aria-label="Controles de pantalla">
    <div class="control-group resolution-group">
      <div class="control-heading"><span>Resolución</span><output x-text="`${width} × ${height}`">1920 × 1080</output></div>
      <div class="size-inputs">
        <label><span>Ancho</span><input type="number" min="1" max="7680" x-model.number="width" /></label><span aria-hidden="true">×</span>
        <label><span>Alto</span><input type="number" min="1" max="4320" x-model.number="height" /></label>
      </div>
      <div class="presets" aria-label="Resoluciones predefinidas">
        <button @click="setSize(1280,720)" type="button">720p</button><button @click="setSize(1920,1080)" class="active" type="button">1080p</button><button @click="setSize(2560,1440)" type="button">2K</button><button @click="setSize(3840,2160)" type="button">4K</button>
      </div>
    </div>
    <div class="control-group color-group">
      <div class="control-heading"><span>Colores</span><span>{colors.length} opciones</span></div>
      <nav class="palette" aria-label="Elegir color de pantalla">
        {colors.map((item) => <a href={colorPath(item)} class:list={["swatch", { selected: item.slug === color.slug }]} style={`--swatch:${item.hex}`} aria-label={`Pantalla ${item.label.toLowerCase()}`} aria-current={item.slug === color.slug ? "page" : undefined} title={item.label}><span>{item.label}</span></a>)}
      </nav>
      <label class="custom-color"><span>Personalizado</span><input type="color" x-model="customColor" aria-label="Elegir color personalizado" /><input type="text" x-model="customColor" maxlength="7" aria-label="Código hexadecimal" /></label>
    </div>
  </section>

  <section class="seo-copy" aria-labelledby="uses-title">
    <p class="eyebrow">Simple y útil</p>
    <h2 id="uses-title">¿Para qué sirve una pantalla {color.adjective}?</h2>
    <div class="use-grid">
      <article><span>01</span><h3>Revisar el monitor</h3><p>Encuentra píxeles muertos, manchas, polvo y cambios de uniformidad con un fondo sólido.</p></article>
      <article><span>02</span><h3>{isWhite ? "Iluminar tu espacio" : "Probar el color"}</h3><p>{isWhite ? "Usa la pantalla como luz suave para videollamadas, fotos, lectura o dibujo." : "Comprueba contraste, saturación y reproducción del color en cualquier pantalla."}</p></article>
      <article><span>03</span><h3>Trabajar sin ruido</h3><p>Convierte una pantalla secundaria en una superficie neutra, limpia y sin distracciones.</p></article>
    </div>
  </section>
  <footer><a href="/">White Screen</a><span>Hecho para verse bien en cualquier pantalla.</span></footer>
</main>

<script>
  document.addEventListener("alpine:init", () => {
    window.Alpine.data("screenTool", (initialColor: string) => ({
      width: 1920, height: 1080, customColor: initialColor,
      setSize(width: number, height: number) { this.width = width; this.height = height; },
      openFullscreen() { const element = this.$refs.canvas as HTMLElement; element.style.setProperty("--screen-color", this.customColor); element.requestFullscreen?.(); },
    }));
  });
</script>
