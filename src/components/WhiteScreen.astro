---
import { colors, type ScreenColor } from "../data/colors";
import { colorName, copy, locales, localizedPath, screenHeading, type Locale } from "../i18n/translations";
import { colorDetail } from "../i18n/color-content";
import SiteHeader from "./SiteHeader.astro";
import SiteFooter from "./SiteFooter.astro";
import GuideHub from "./GuideHub.astro";
interface Props {
  color: ScreenColor;
  locale: Locale;
}
const { color, locale } = Astro.props;
const t = copy[locale];
const currentColor = colorName(locale, color);
const detail = colorDetail(locale, color);
const languagePaths = Object.fromEntries(locales.map(item => [item, localizedPath(item, color)])) as Record<Locale,string>;
const faqs = t.faq.map(({ q, a }) => ({ question: q, answer: a }));
const faqSchema = { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faqs.map(({ question, answer }) => ({ "@type": "Question", name: question, acceptedAnswer: { "@type": "Answer", text: answer } })) };
---

<main x-data={`screenTool('${color.hex}')`} class="site-shell">
  <SiteHeader locale={locale} languagePaths={languagePaths} showFree />

  <section class="screen-hero" aria-labelledby="page-title">
    <div class="screen-hero-copy">
      <p class="eyebrow">{t.tool}</p>
      <h1 id="page-title">{screenHeading(locale, color)}</h1>
      <p>{t.hero}</p>
    </div>
    <button
      x-ref="canvas"
      @click="toggleFullscreen()"
      @keydown.f.window.prevent="toggleFullscreen()"
      class="screen-preview"
      :class="{ 'pseudo-fullscreen': isPseudoFullscreen }"
      style={`--screen-color:${color.hex}; --screen-text:${color.text}`}
      :style="`--screen-color: ${validColor}; --screen-text: ${previewText}`"
      type="button"
      aria-label={`${t.fullscreen}: ${currentColor}`}
    >
      <span class="preview-label">{t.click}</span>
      <span class="preview-action"
        >{t.fullscreen} <span aria-hidden="true">↗</span></span
      >
      <span class="fullscreen-exit" x-show="isFullscreen" x-cloak aria-hidden="true">×</span>
    </button>
  </section>

  <section class="tool-card" aria-label="Controles de pantalla">
    <div class="control-group resolution-group">
      <div class="control-heading">
        <span>{t.resolution}</span><output x-text="`${width} × ${height}`"
          >1920 × 1080</output
        >
      </div>
      <div class="size-inputs">
        <label
          ><span>{t.width}</span><input
            type="number"
            min="1"
            max="7680"
            x-model.number="width"
          /></label
        ><span aria-hidden="true">×</span>
        <label
          ><span>{t.height}</span><input
            type="number"
            min="1"
            max="4320"
            x-model.number="height"
          /></label
        >
      </div>
      <div class="presets" aria-label="Resoluciones predefinidas">
        <button
          @click="setSize(854,480)"
          :class="width === 854 && height === 480 && 'active'"
          type="button">480p</button
        ><button
          @click="setSize(1280,720)"
          :class="width === 1280 && height === 720 && 'active'"
          type="button">720p</button
        ><button
          @click="setSize(1920,1080)"
          :class="width === 1920 && height === 1080 && 'active'"
          type="button">1080p</button
        ><button
          @click="setSize(2560,1440)"
          :class="width === 2560 && height === 1440 && 'active'"
          type="button">2K</button
        ><button
          @click="setSize(3840,2160)"
          :class="width === 3840 && height === 2160 && 'active'"
          type="button">4K</button
        >
      </div>
    </div>
    <div class="control-group color-group">
      <div class="control-heading">
        <span>{t.colorsLabel}</span><span>{colors.length} {t.options}</span>
      </div>
      <nav class="palette" aria-label="Elegir color de pantalla">
        {
          colors.map((item) => (
            <a
            href={localizedPath(locale, item)}
              class:list={["swatch", { selected: item.slug === color.slug }]}
              style={`--swatch:${item.hex}`}
            aria-label={`${item.name} Screen`}
              aria-current={item.slug === color.slug ? "page" : undefined}
            title={colorName(locale, item)}
            >
              <span>{item.label}</span>
            </a>
          ))
        }
      </nav>
      <div class="custom-color">
        <span>{t.custom}</span>
        <label class="color-picker" title="Abrir selector de color"
          ><span class="sr-only">Elegir color personalizado</span><input
            type="color"
            x-model="customColor"
            aria-label="Elegir color personalizado"
          /></label
        >
        <label class="hex-field"
          ><span class="sr-only">Código hexadecimal</span><input
            type="text"
            x-model="customColor"
            maxlength="7"
            spellcheck="false"
            aria-label="Código hexadecimal"
          /></label
        >
      </div>
      <button class="download-button" type="button" @click="downloadImage()">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m0 0 5-5m-5 5-5-5M5 20h14"></path></svg>
        <span>{t.download}</span>
        <small x-text="`${width} × ${height}`">1920 × 1080</small>
      </button>
    </div>
  </section>

  <section class="seo-copy" aria-labelledby="uses-title">
    <p class="eyebrow">{t.simple}</p>
    <h2 id="uses-title">{t.purpose(currentColor)}</h2>
    <p class="section-lead">{t.lead}</p>
    <div class="use-grid">
      <article>
        <span>01</span><h3>{t.cards[0].title}</h3><p>{t.cards[0].text}</p>
      </article>
      <article>
        <span>02</span><h3>
          {detail.title}
        </h3><p>
          {
            detail.text
          }
        </p>
      </article>
      <article>
        <span>03</span><h3>{t.cards[1].title}</h3><p>{t.cards[1].text}</p>
      </article>
    </div>
  </section>

  <section class="content-section how-to" aria-labelledby="how-to-title">
    <div><p class="eyebrow">{t.howLabel}</p><h2 id="how-to-title">{t.howTitle}</h2></div>
    <ol>
      {t.steps.map((step, index) => <li><span>{index + 1}</span><div><h3>{step.title}</h3><p>{step.text}</p></div></li>)}
    </ol>
  </section>

  <section class="content-section faq-section" aria-labelledby="faq-title">
    <p class="eyebrow">{t.faqLabel}</p>
    <h2 id="faq-title">{t.faqTitle(currentColor)}</h2>
    <div class="faq-list">
      {faqs.map((faq, index) => <details open={index === 0}><summary>{faq.question}<span aria-hidden="true">+</span></summary><p>{faq.answer}</p></details>)}
    </div>
  </section>

  <nav class="content-section related-colors" aria-labelledby="related-title">
    <div><p class="eyebrow">{t.more}</p><h2 id="related-title">{t.other}</h2></div>
    <div>{colors.filter((item) => item.slug !== color.slug).map((item) => <a href={localizedPath(locale, item)}><i style={`--related-color:${item.hex}`}></i>{screenHeading(locale, item)}</a>)}</div>
  </nav>

  <GuideHub locale={locale} home />

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <SiteFooter locale={locale} languagePaths={languagePaths} />
</main>
