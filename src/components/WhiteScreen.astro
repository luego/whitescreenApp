---
import { colors, colorPath, type ScreenColor } from "../data/colors";
interface Props {
  color: ScreenColor;
}
const { color } = Astro.props;
const isWhite = color.slug === "";
const faqs = [
  { question: `¿Cuándo conviene utilizar una pantalla ${color.adjective}?`, answer: `Puedes utilizarla para revisar la uniformidad del panel, detectar píxeles defectuosos, limpiar la pantalla o disponer de un fondo ${color.adjective} sin distracciones.` },
  { question: "¿Esta herramienta es gratuita?", answer: "Sí. Puedes utilizarla directamente en el navegador sin crear una cuenta, instalar programas ni realizar pagos." },
  { question: "¿Sirve para detectar píxeles muertos?", answer: "Sí. Revisa la pantalla a corta distancia y cambia entre blanco, negro, rojo, verde y azul. Un punto que no cambia correctamente puede indicar un píxel muerto o atascado." },
  { question: "¿Funciona en móviles y tabletas?", answer: "Sí. La interfaz se adapta a pantallas pequeñas y permite abrir el área de color en pantalla completa cuando el navegador y el dispositivo lo permiten." },
  { question: "¿Puedo elegir un color diferente?", answer: "Sí. Utiliza los colores disponibles o introduce un valor hexadecimal en el selector personalizado para mostrar el tono que necesites." },
];
const faqSchema = { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faqs.map(({ question, answer }) => ({ "@type": "Question", name: question, acceptedAnswer: { "@type": "Answer", text: answer } })) };
---

<main x-data={`screenTool('${color.hex}')`} x-init="initTheme()" class="site-shell">
  <header class="topbar">
    <a href="/" class="brand" aria-label="White Screen — inicio"
      ><span class="brand-mark" aria-hidden="true"></span><span
        >White Screen</span
      ></a
    >
    <div class="header-actions">
      <span class="top-note">Herramienta gratuita · Sin registro</span>
      <div class="theme-switcher" role="group" aria-label="Tema de la interfaz">
        <button @click="setTheme('light')" :class="themeMode === 'light' && 'active'" :aria-pressed="themeMode === 'light'" class="theme-button" type="button" aria-label="Tema claro" title="Tema claro"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41"></path></svg></button>
        <button @click="setTheme('dark')" :class="themeMode === 'dark' && 'active'" :aria-pressed="themeMode === 'dark'" class="theme-button" type="button" aria-label="Tema oscuro" title="Tema oscuro"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"></path></svg></button>
        <button @click="setTheme('system')" :class="themeMode === 'system' && 'active'" :aria-pressed="themeMode === 'system'" class="theme-button" type="button" aria-label="Usar tema del sistema" title="Tema del sistema"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="13" rx="2"></rect><path d="M8 21h8M12 17v4"></path></svg></button>
      </div>
    </div>
  </header>

  <section class="screen-hero" aria-labelledby="page-title">
    <div class="screen-hero-copy">
      <p class="eyebrow">Pantalla de color online</p>
      <h1 id="page-title">Pantalla {color.adjective}</h1>
      <p>
        Una superficie limpia para iluminar, revisar tu monitor o trabajar sin
        distracciones.
      </p>
    </div>
    <button
      x-ref="canvas"
      @click="openFullscreen()"
      @keydown.f.window.prevent="openFullscreen()"
      class="screen-preview"
      style={`--screen-color:${color.hex}; --screen-text:${color.text}`}
      :style="`--screen-color: ${validColor}; --screen-text: ${previewText}`"
      type="button"
      aria-label={`Abrir pantalla ${color.adjective} en pantalla completa`}
    >
      <span class="preview-label">Haz clic o pulsa F</span>
      <span class="preview-action"
        >Pantalla completa <span aria-hidden="true">↗</span></span
      >
    </button>
  </section>

  <section class="tool-card" aria-label="Controles de pantalla">
    <div class="control-group resolution-group">
      <div class="control-heading">
        <span>Resolución</span><output x-text="`${width} × ${height}`"
          >1920 × 1080</output
        >
      </div>
      <div class="size-inputs">
        <label
          ><span>Ancho</span><input
            type="number"
            min="1"
            max="7680"
            x-model.number="width"
          /></label
        ><span aria-hidden="true">×</span>
        <label
          ><span>Alto</span><input
            type="number"
            min="1"
            max="4320"
            x-model.number="height"
          /></label
        >
      </div>
      <div class="presets" aria-label="Resoluciones predefinidas">
        <button
          @click="setSize(854,480)"
          :class="width === 854 && height === 480 && 'active'"
          type="button">480p</button
        ><button
          @click="setSize(1280,720)"
          :class="width === 1280 && height === 720 && 'active'"
          type="button">720p</button
        ><button
          @click="setSize(1920,1080)"
          :class="width === 1920 && height === 1080 && 'active'"
          type="button">1080p</button
        ><button
          @click="setSize(2560,1440)"
          :class="width === 2560 && height === 1440 && 'active'"
          type="button">2K</button
        ><button
          @click="setSize(3840,2160)"
          :class="width === 3840 && height === 2160 && 'active'"
          type="button">4K</button
        >
      </div>
    </div>
    <div class="control-group color-group">
      <div class="control-heading">
        <span>Colores</span><span>{colors.length} opciones</span>
      </div>
      <nav class="palette" aria-label="Elegir color de pantalla">
        {
          colors.map((item) => (
            <a
              href={colorPath(item)}
              class:list={["swatch", { selected: item.slug === color.slug }]}
              style={`--swatch:${item.hex}`}
              aria-label={`Pantalla ${item.label.toLowerCase()}`}
              aria-current={item.slug === color.slug ? "page" : undefined}
              title={item.label}
            >
              <span>{item.label}</span>
            </a>
          ))
        }
      </nav>
      <div class="custom-color">
        <span>Color personalizado</span>
        <label class="color-picker" title="Abrir selector de color"
          ><span class="sr-only">Elegir color personalizado</span><input
            type="color"
            x-model="customColor"
            aria-label="Elegir color personalizado"
          /></label
        >
        <label class="hex-field"
          ><span class="sr-only">Código hexadecimal</span><input
            type="text"
            x-model="customColor"
            maxlength="7"
            spellcheck="false"
            aria-label="Código hexadecimal"
          /></label
        >
      </div>
    </div>
  </section>

  <section class="seo-copy" aria-labelledby="uses-title">
    <p class="eyebrow">Simple y útil</p>
    <h2 id="uses-title">¿Para qué sirve una pantalla {color.adjective}?</h2>
    <p class="section-lead">Una pantalla de color sólido permite revisar el estado de un panel y también funciona como una superficie visual limpia. No requiere descargas y se adapta a ordenadores, móviles, tabletas y televisores.</p>
    <div class="use-grid">
      <article>
        <span>01</span><h3>Revisar y limpiar el monitor</h3><p>
          Localiza píxeles muertos, polvo, huellas, manchas y diferencias de
          brillo sobre una superficie uniforme.
        </p>
      </article>
      <article>
        <span>02</span><h3>
          {isWhite ? "Iluminar tu espacio" : "Evaluar el color"}
        </h3><p>
          {
            isWhite
              ? "Utiliza el brillo de la pantalla como una luz suave para videollamadas, fotografía, lectura o dibujo."
              : "Comprueba el contraste, la saturación y la reproducción del tono en diferentes dispositivos."
          }
        </p>
      </article>
      <article>
        <span>03</span><h3>Crear un fondo limpio</h3><p>
          Úsala como fondo temporal para presentaciones, fotografías,
          grabaciones o una pantalla secundaria sin distracciones.
        </p>
      </article>
    </div>
  </section>

  <section class="content-section how-to" aria-labelledby="how-to-title">
    <div><p class="eyebrow">Cómo utilizarla</p><h2 id="how-to-title">Lista en tres pasos</h2></div>
    <ol>
      <li><span>1</span><div><h3>Elige el color</h3><p>Selecciona una pantalla predefinida o introduce un color hexadecimal personalizado.</p></div></li>
      <li><span>2</span><div><h3>Ajusta tu dispositivo</h3><p>Sube o baja el brillo físico de la pantalla según la prueba o el uso que necesites.</p></div></li>
      <li><span>3</span><div><h3>Abre la pantalla completa</h3><p>Pulsa el canvas o la tecla F para ocultar la interfaz y mostrar únicamente el color.</p></div></li>
    </ol>
  </section>

  <section class="content-section faq-section" aria-labelledby="faq-title">
    <p class="eyebrow">Preguntas frecuentes</p>
    <h2 id="faq-title">Todo sobre la pantalla {color.adjective}</h2>
    <div class="faq-list">
      {faqs.map((faq, index) => <details open={index === 0}><summary>{faq.question}<span aria-hidden="true">+</span></summary><p>{faq.answer}</p></details>)}
    </div>
  </section>

  <nav class="content-section related-colors" aria-labelledby="related-title">
    <div><p class="eyebrow">Más herramientas</p><h2 id="related-title">Prueba otros colores</h2></div>
    <div>{colors.filter((item) => item.slug !== color.slug).map((item) => <a href={colorPath(item)}><i style={`--related-color:${item.hex}`}></i>Pantalla {item.adjective}</a>)}</div>
  </nav>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <footer>
    <a href="/">White Screen</a><span
      >Hecho para verse bien en cualquier pantalla.</span
    >
  </footer>
</main>

<script>
  document.addEventListener("alpine:init", () => {
    window.Alpine.data("screenTool", (initialColor: string) => ({
      width: 1920,
      height: 1080,
      customColor: initialColor,
      themeMode: "system",
      initTheme() {
        const saved = localStorage.getItem("theme-mode");
        this.themeMode = ["light", "dark", "system"].includes(saved || "") ? saved : "system";
        this.applyTheme();
        window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", () => { if (this.themeMode === "system") this.applyTheme(); });
      },
      setTheme(mode: string) {
        this.themeMode = mode;
        localStorage.setItem("theme-mode", mode);
        this.applyTheme();
      },
      applyTheme() {
        const dark = this.themeMode === "dark" || (this.themeMode === "system" && window.matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.dataset.theme = dark ? "night" : "bumblebee";
        document.querySelector('meta[name="theme-color"]')?.setAttribute("content", dark ? "#0f172a" : "#facc15");
      },
      get validColor() {
        return /^#[0-9a-f]{6}$/i.test(this.customColor)
          ? this.customColor
          : initialColor;
      },
      get previewText() {
        const value = this.validColor.slice(1);
        const red = parseInt(value.slice(0, 2), 16),
          green = parseInt(value.slice(2, 4), 16),
          blue = parseInt(value.slice(4, 6), 16);
        return (red * 299 + green * 587 + blue * 114) / 1000 > 145
          ? "#141414"
          : "#ffffff";
      },
      setSize(width: number, height: number) {
        this.width = width;
        this.height = height;
      },
      openFullscreen() {
        (this.$refs.canvas as HTMLElement).requestFullscreen?.();
      },
    }));
  });
</script>
