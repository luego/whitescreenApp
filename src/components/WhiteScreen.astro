---
import { colors, type ScreenColor } from "../data/colors";
import { colorName, copy, localeNames, locales, localizedPath, screenHeading, type Locale } from "../i18n/translations";
interface Props {
  color: ScreenColor;
  locale: Locale;
}
const { color, locale } = Astro.props;
const isWhite = color.slug === "";
const t = copy[locale];
const currentColor = colorName(locale, color);
const faqs = t.faq.map(({ q, a }) => ({ question: q, answer: a }));
const faqSchema = { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faqs.map(({ question, answer }) => ({ "@type": "Question", name: question, acceptedAnswer: { "@type": "Answer", text: answer } })) };
---

<main x-data={`screenTool('${color.hex}')`} x-init="initTheme()" class="site-shell">
  <header class="topbar">
    <a href={localizedPath(locale)} class="brand" aria-label="White Screen"
      ><span class="brand-mark" aria-hidden="true"></span><span
        >White Screen</span
      ></a
    >
    <div class="header-actions">
      <span class="top-note">{t.free}</span>
      <details class="language-menu">
        <summary aria-label={t.language} title={t.language}><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"></path></svg><span>{locale.toUpperCase()}</span></summary>
        <div>{locales.map((item) => <a href={localizedPath(item, color)} lang={item} aria-current={item === locale ? "page" : undefined}>{localeNames[item]}</a>)}</div>
      </details>
      <div class="theme-switcher" role="group" aria-label="Tema de la interfaz">
        <button @click="setTheme('light')" :class="themeMode === 'light' && 'active'" :aria-pressed="themeMode === 'light'" class="theme-button" type="button" aria-label={t.light} title={t.light}><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41"></path></svg></button>
        <button @click="setTheme('dark')" :class="themeMode === 'dark' && 'active'" :aria-pressed="themeMode === 'dark'" class="theme-button" type="button" aria-label={t.dark} title={t.dark}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"></path></svg></button>
        <button @click="setTheme('system')" :class="themeMode === 'system' && 'active'" :aria-pressed="themeMode === 'system'" class="theme-button" type="button" aria-label={t.system} title={t.system}><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="13" rx="2"></rect><path d="M8 21h8M12 17v4"></path></svg></button>
      </div>
    </div>
  </header>

  <section class="screen-hero" aria-labelledby="page-title">
    <div class="screen-hero-copy">
      <p class="eyebrow">{t.tool}</p>
      <h1 id="page-title">{screenHeading(locale, color)}</h1>
      <p>{t.hero}</p>
    </div>
    <button
      x-ref="canvas"
      @click="openFullscreen()"
      @keydown.f.window.prevent="openFullscreen()"
      class="screen-preview"
      style={`--screen-color:${color.hex}; --screen-text:${color.text}`}
      :style="`--screen-color: ${validColor}; --screen-text: ${previewText}`"
      type="button"
      aria-label={`${t.fullscreen}: ${currentColor}`}
    >
      <span class="preview-label">{t.click}</span>
      <span class="preview-action"
        >{t.fullscreen} <span aria-hidden="true">↗</span></span
      >
    </button>
  </section>

  <section class="tool-card" aria-label="Controles de pantalla">
    <div class="control-group resolution-group">
      <div class="control-heading">
        <span>{t.resolution}</span><output x-text="`${width} × ${height}`"
          >1920 × 1080</output
        >
      </div>
      <div class="size-inputs">
        <label
          ><span>{t.width}</span><input
            type="number"
            min="1"
            max="7680"
            x-model.number="width"
          /></label
        ><span aria-hidden="true">×</span>
        <label
          ><span>{t.height}</span><input
            type="number"
            min="1"
            max="4320"
            x-model.number="height"
          /></label
        >
      </div>
      <div class="presets" aria-label="Resoluciones predefinidas">
        <button
          @click="setSize(854,480)"
          :class="width === 854 && height === 480 && 'active'"
          type="button">480p</button
        ><button
          @click="setSize(1280,720)"
          :class="width === 1280 && height === 720 && 'active'"
          type="button">720p</button
        ><button
          @click="setSize(1920,1080)"
          :class="width === 1920 && height === 1080 && 'active'"
          type="button">1080p</button
        ><button
          @click="setSize(2560,1440)"
          :class="width === 2560 && height === 1440 && 'active'"
          type="button">2K</button
        ><button
          @click="setSize(3840,2160)"
          :class="width === 3840 && height === 2160 && 'active'"
          type="button">4K</button
        >
      </div>
    </div>
    <div class="control-group color-group">
      <div class="control-heading">
        <span>{t.colorsLabel}</span><span>{colors.length} {t.options}</span>
      </div>
      <nav class="palette" aria-label="Elegir color de pantalla">
        {
          colors.map((item) => (
            <a
            href={localizedPath(locale, item)}
              class:list={["swatch", { selected: item.slug === color.slug }]}
              style={`--swatch:${item.hex}`}
            aria-label={`${item.name} Screen`}
              aria-current={item.slug === color.slug ? "page" : undefined}
            title={colorName(locale, item)}
            >
              <span>{item.label}</span>
            </a>
          ))
        }
      </nav>
      <div class="custom-color">
        <span>{t.custom}</span>
        <label class="color-picker" title="Abrir selector de color"
          ><span class="sr-only">Elegir color personalizado</span><input
            type="color"
            x-model="customColor"
            aria-label="Elegir color personalizado"
          /></label
        >
        <label class="hex-field"
          ><span class="sr-only">Código hexadecimal</span><input
            type="text"
            x-model="customColor"
            maxlength="7"
            spellcheck="false"
            aria-label="Código hexadecimal"
          /></label
        >
      </div>
    </div>
  </section>

  <section class="seo-copy" aria-labelledby="uses-title">
    <p class="eyebrow">{t.simple}</p>
    <h2 id="uses-title">{t.purpose(currentColor)}</h2>
    <p class="section-lead">{t.lead}</p>
    <div class="use-grid">
      <article>
        <span>01</span><h3>{t.cards[0].title}</h3><p>{t.cards[0].text}</p>
      </article>
      <article>
        <span>02</span><h3>
          {isWhite ? t.whiteCard.title : t.colorCard.title}
        </h3><p>
          {
            isWhite ? t.whiteCard.text : t.colorCard.text
          }
        </p>
      </article>
      <article>
        <span>03</span><h3>{t.cards[1].title}</h3><p>{t.cards[1].text}</p>
      </article>
    </div>
  </section>

  <section class="content-section how-to" aria-labelledby="how-to-title">
    <div><p class="eyebrow">{t.howLabel}</p><h2 id="how-to-title">{t.howTitle}</h2></div>
    <ol>
      {t.steps.map((step, index) => <li><span>{index + 1}</span><div><h3>{step.title}</h3><p>{step.text}</p></div></li>)}
    </ol>
  </section>

  <section class="content-section faq-section" aria-labelledby="faq-title">
    <p class="eyebrow">{t.faqLabel}</p>
    <h2 id="faq-title">{t.faqTitle(currentColor)}</h2>
    <div class="faq-list">
      {faqs.map((faq, index) => <details open={index === 0}><summary>{faq.question}<span aria-hidden="true">+</span></summary><p>{faq.answer}</p></details>)}
    </div>
  </section>

  <nav class="content-section related-colors" aria-labelledby="related-title">
    <div><p class="eyebrow">{t.more}</p><h2 id="related-title">{t.other}</h2></div>
    <div>{colors.filter((item) => item.slug !== color.slug).map((item) => <a href={localizedPath(locale, item)}><i style={`--related-color:${item.hex}`}></i>{screenHeading(locale, item)}</a>)}</div>
  </nav>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <footer>
    <div class="footer-copy"><a href={localizedPath(locale)}>White Screen</a><span>{t.footer}</span></div>
    <nav class="footer-languages" aria-label={t.language}>
      {locales.map((item) => <a href={localizedPath(item, color)} lang={item} aria-current={item === locale ? "page" : undefined}>{localeNames[item]}</a>)}
    </nav>
  </footer>
</main>

<script>
  document.addEventListener("alpine:init", () => {
    window.Alpine.data("screenTool", (initialColor: string) => ({
      width: 1920,
      height: 1080,
      customColor: initialColor,
      themeMode: "system",
      initTheme() {
        const saved = localStorage.getItem("theme-mode");
        this.themeMode = ["light", "dark", "system"].includes(saved || "") ? saved : "system";
        this.applyTheme();
        window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", () => { if (this.themeMode === "system") this.applyTheme(); });
      },
      setTheme(mode: string) {
        this.themeMode = mode;
        localStorage.setItem("theme-mode", mode);
        this.applyTheme();
      },
      applyTheme() {
        const dark = this.themeMode === "dark" || (this.themeMode === "system" && window.matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.dataset.theme = dark ? "night" : "bumblebee";
        document.querySelector('meta[name="theme-color"]')?.setAttribute("content", dark ? "#0f172a" : "#facc15");
      },
      get validColor() {
        return /^#[0-9a-f]{6}$/i.test(this.customColor)
          ? this.customColor
          : initialColor;
      },
      get previewText() {
        const value = this.validColor.slice(1);
        const red = parseInt(value.slice(0, 2), 16),
          green = parseInt(value.slice(2, 4), 16),
          blue = parseInt(value.slice(4, 6), 16);
        return (red * 299 + green * 587 + blue * 114) / 1000 > 145
          ? "#141414"
          : "#ffffff";
      },
      setSize(width: number, height: number) {
        this.width = width;
        this.height = height;
      },
      openFullscreen() {
        (this.$refs.canvas as HTMLElement).requestFullscreen?.();
      },
    }));
  });
</script>
