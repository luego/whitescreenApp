---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import type { ScreenColor } from "../data/colors";
import { locales, localizedPath, type Locale } from "../i18n/translations";
import GoogleAnalytics from "../components/GoogleAnalytics.astro";

interface Props {
  title: string;
  description: string;
  locale: Locale;
  color?: ScreenColor;
  alternatePaths?: Partial<Record<Locale, string>>;
  pageType?: "app" | "page";
}
const {
  title,
  description,
  locale,
  color,
  alternatePaths,
  pageType = "app",
} = Astro.props;
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : undefined;
const socialImage = Astro.site
  ? new URL("/og-white-screen.png", Astro.site)
  : "/og-white-screen.png";
const alternateHref = (item: Locale) =>
  alternatePaths?.[item] ??
  (color ? localizedPath(item, color) : localizedPath(item));
const structuredData =
  pageType === "app"
    ? {
        "@context": "https://schema.org",
        "@type": "WebApplication",
        name: "White Screen",
        applicationCategory: "UtilitiesApplication",
        operatingSystem: "Any",
        inLanguage: locale,
        description,
        offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
      }
    : {
        "@context": "https://schema.org",
        "@type": "WebPage",
        name: title,
        inLanguage: locale,
        description,
      };
const ogLocales: Record<Locale, string> = {
  en: "en_US",
  de: "de_DE",
  es: "es_ES",
  pt: "pt_PT",
  fr: "fr_FR",
  it: "it_IT",
  nl: "nl_NL",
};
---

<!doctype html>
<html lang={locale} data-theme="bumblebee">
  <head>
    <meta charset="utf-8" /><meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    /><meta name="theme-color" content="#facc15" />
    <meta name="description" content={description} /><meta
      name="robots"
      content="index, follow"
    />
    <meta property="og:type" content="website" /><meta
      property="og:site_name"
      content="White Screen"
    /><meta property="og:title" content={title} /><meta
      property="og:description"
      content={description}
    /><meta property="og:locale" content={ogLocales[locale]} /><meta
      property="og:image"
      content={socialImage}
    /><meta property="og:image:width" content="1200" /><meta
      property="og:image:height"
      content="630"
    /><meta
      property="og:image:alt"
      content="White Screen — Simple color screens for every display"
    />{canonical && <meta property="og:url" content={canonical} />}<meta
      name="twitter:card"
      content="summary_large_image"
    /><meta name="twitter:title" content={title} /><meta
      name="twitter:description"
      content={description}
    /><meta name="twitter:image" content={socialImage} />
    {canonical && <link rel="canonical" href={canonical} />}
    {
      locales.map((item) => (
        <link
          rel="alternate"
          hreflang={item}
          href={
            Astro.site
              ? new URL(alternateHref(item), Astro.site)
              : alternateHref(item)
          }
        />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={Astro.site
        ? new URL(alternateHref("en"), Astro.site)
        : alternateHref("en")}
    />
    <link rel="icon" href="/favicon.svg" /><link
      rel="manifest"
      href="/manifest.webmanifest"
    /><meta name="application-name" content="White Screen" /><meta
      name="apple-mobile-web-app-capable"
      content="yes"
    /><meta
      name="apple-mobile-web-app-status-bar-style"
      content="default"
    /><link rel="apple-touch-icon" href="/icons/app-icon.svg" /><meta
      name="generator"
      content={Astro.generator}
    />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>{title}</title><script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    /><ClientRouter fallback="swap" />
    <script is:inline>
      (() => {
        const saved = localStorage.getItem("theme-mode") || "system";
        const dark =
          saved === "dark" ||
          (saved === "system" &&
            matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.dataset.theme = dark ? "night" : "bumblebee";
      })();
    </script>
    <GoogleAnalytics measurementId={"G-3KNQ782FP6"} />
  </head>
  <body transition:animate="none">
    <slot />
    <script is:inline>
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () =>
          navigator.serviceWorker.register("/sw.js").catch(() => {}),
        );
      }
    </script>
  </body>
</html>
